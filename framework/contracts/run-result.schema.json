{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/run-result.schema.json",
  "title": "Portable Agent Run Result Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "agent_id",
    "status",
    "outcome",
    "evidence",
    "side_effects",
    "errors",
    "next_action"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "incomplete",
        "blocked",
        "failed",
        "cancelled",
        "escalated"
      ]
    },
    "outcome": {
      "type": [
        "object",
        "null"
      ],
      "description": "Validated task-specific output; schema is owned by its workflow"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "source_type"
        ],
        "properties": {
          "ref": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "observed_at": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tool_id",
          "effect_id",
          "confirmed"
        ],
        "properties": {
          "tool_id": {
            "type": "string"
          },
          "effect_id": {
            "type": "string"
          },
          "confirmed": {
            "type": "boolean"
          },
          "reversal_ref": {
            "type": "string"
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        }
      }
    },
    "next_action": {
      "type": "string",
      "enum": [
        "none",
        "retry",
        "await_approval",
        "escalate",
        "schedule_followup"
      ]
    },
    "trace_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "directive_version": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
